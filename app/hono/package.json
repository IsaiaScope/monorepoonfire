{
  "name": "@app/hono",
  "type": "module",
  "version": "0.0.1",
  "exports": {
    "./rpc": {
      "import": "./src/library/rpc.ts"
    },
    "./constant": {
      "import": "./src/constant/index.ts"
    }
  },
  "scripts": {
    "start": "cross-env NODE_ENV=development node dist/src/index.js",
    "start:production": "cross-env NODE_ENV=production node dist/src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "cross-env NODE_ENV=development drizzle-kit migrate",
    "db:migrate:production": "cross-env NODE_ENV=production drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "cross-env NODE_ENV=development tsx src/database/seed.ts",
    "db:fresh": "drizzle-kit push && cross-env NODE_ENV=development tsx src/database/seed.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "dev:production": "cross-env NODE_ENV=production tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "build:production": "tsc && tsc-alias",
    "test": "cross-env NODE_ENV=development vitest run",
    "test:watch": "cross-env NODE_ENV=development vitest --watch"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@hono/zod-openapi": "^0.19.6",
    "@scalar/hono-api-reference": "^0.8.10",
    "@t3-oss/env-core": "^0.12.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "dotenv-expand": "^12.0.2",
    "drizzle-orm": "^0.43.1",
    "hono": "^4.12.4",
    "hono-pino": "^0.8.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "stoker": "^1.4.2",
    "zod": "^3.25.12"
  },
  "devDependencies": {
    "@package/config": "workspace:*",
    "@types/node": "^20.17.46",
    "drizzle-kit": "^0.31.1",
    "eslint-plugin-drizzle": "^0.2.3",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*": [
      "pnpm lint:fix",
      "pnpm lint"
    ]
  }
}
