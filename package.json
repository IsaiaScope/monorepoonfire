{
  "name": "monorepoonfire",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.1.1",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "turbo run build",
    "build:test": "turbo run build:test",
    "build:production": "turbo run build:production",
    "test": "turbo run test",
    "test:test": "turbo run test:test",
    "dev": "turbo run dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "pre-commit": "lint-staged --allow-empty",
    "commit-msg": "npx --no -- commitlint --edit",
    "check-types": "turbo run check-types",
    "prepare": "husky",
    "prune:turbo": "turbo prune --scope @app/hono"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "eslint": "^9.26.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "turbo": "^2.5.3",
    "typescript": "5.8.2"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "scope-case": [2, "always", ["lower-case", "upper-case"]],
      "scope-empty": [2, "never"]
    }
  },
  "volta": {
    "node": "22.14.0"
  }
}
