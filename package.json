{
  "name": "my-turborepo",
  "private": true,
  "packageManager": "pnpm@9.1.1",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pre-commit": "lint-staged --concurrent=false --allow-empty",
    "commit-msg": "npx --no -- commitlint --edit",
    "check-types": "turbo run check-types",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "eslint": "^9.26.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "turbo": "^2.5.3",
    "typescript": "5.8.2"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "scope-case": [2, "always", ["lower-case", "upper-case"]],
      "scope-empty": [2, "never"]
    }
  },
  "lint-staged": {
    "*": [
      "pnpm lint:fix",
      "pnpm lint"
    ]
  },
  "volta": {
    "node": "22.14.0"
  }
}
