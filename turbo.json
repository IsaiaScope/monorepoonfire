{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",

  "tasks": {
    "test": {
      "dependsOn": ["^test"]
    },
    "test:test": {
      "dependsOn": ["^test:test"]
    },
    "build": {
      "dependsOn": ["^build"]

    },
    "build:test": {
      "dependsOn": ["^build:test"]

    },
    "build:production": {
      "dependsOn": ["^build:production"]

    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
