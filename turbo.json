{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",

  "tasks": {
    "test": {
      "dependsOn": ["^test"],
      "inputs": [".env*"]
    },
    "test:watch": {
      "dependsOn": ["^test:watch"],
      "inputs": [".env*"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [".env*"]

    },
    "build:production": {
      "dependsOn": ["^build:production"],
      "inputs": [".env*"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "e2e": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
